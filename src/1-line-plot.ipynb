import matplotlib.pyplot as plt
x = list(range(11))
y = [i**2 for i in x]
plt.plot(x,y)
plt.title("Line Plot of x vs x^2")
plt.xlabel("x values")
plt.ylabel("y values (x^2)")
plt.grid(True)
plt.show
